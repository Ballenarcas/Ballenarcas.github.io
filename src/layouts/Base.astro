---
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/sora';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { author, otherLangPath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown>;
}
const { lang, title, description = t(lang, 'site.description'), image = '/og.png', jsonLd } = Astro.props;
const fullTitle = title ? `${title} · ${author.name}` : t(lang, 'site.title');
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const other: Lang = lang === 'es' ? 'en' : 'es';
const alt = new URL(otherLangPath(path, lang), Astro.site);
const es = lang === 'es' ? canonical : alt;
const en = lang === 'en' ? canonical : alt;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080711" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={es} />
    <link rel="alternate" hreflang="en" href={en} />
    <link rel="alternate" hreflang="x-default" href={es} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={other === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Before the first paint: scripts run, and whether the projects can be a 3D orbit (WebGL 2, motion
      // allowed, not a data-saving or very small device). Deciding it now keeps the layout from jumping.
      (function () {
        var d = document.documentElement, n = navigator;
        d.classList.add('js');
        try {
          if (new URLSearchParams(location.search).has('flat') || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if ((n.connection && n.connection.saveData) || (n.deviceMemory || 8) <= 2) return;
          var gl = document.createElement('canvas').getContext('webgl2');
          if (!gl) return;
          d.classList.add('orbit-on');
          var lose = gl.getExtension('WEBGL_lose_context');
          if (lose) lose.loseContext();
        } catch (e) {}
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'nav.skip')}</a>
    <!-- The space scene. It is kept alive between pages, so the Moon travels instead of reloading. -->
    <div class="space" id="space" aria-hidden="true" transition:persist="space">
      <canvas></canvas>
      <img class="moon2d" src="/textures/moon-still.webp" alt="" width="1024" height="1024" decoding="async" />
    </div>
    <div class="grain" aria-hidden="true"></div>
    <div class="page">
      <slot />
    </div>
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
