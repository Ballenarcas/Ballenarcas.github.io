---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
// A nod to Steins;Gate: a divergence meter in Nixie tubes. This page belongs to no world line.
const reading = '1.048596';
---
<Base lang="es" title={t('es', '404.title')}>
  <main id="main" class="page-head" data-pose="page" style="min-height:100svh;align-content:center;padding-top:0">
    <p class="hud label">404</p>
    <div class="divergence" role="img" aria-label={`Medidor de divergencia: ${reading} · Divergence meter: ${reading}`} data-divergence={reading}>
      {[...reading].map((c) => (c === '.' ? <span class="tube dot" aria-hidden="true"><b>.</b></span> : <span class="tube" aria-hidden="true"><b>{c}</b></span>))}
    </div>
    <h1 class="display">{t('es', '404.title')} · <span lang="en">{t('en', '404.title')}</span></h1>
    <p class="lead" style="max-width:48ch">
      Esta línea temporal no existe: la página que buscas está en otra.<br />
      <span lang="en">This world line does not exist: the page you are after is on another.</span>
    </p>
    <p class="hud worldline">El Psy Kongroo.</p>
    <p style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href="/es/">{t('es', '404.home')}</a><a class="btn" href="/en/" lang="en">{t('en', '404.home')}</a></p>
  </main>
</Base>

<style>
  .divergence { display: flex; gap: clamp(4px, 1vw, 8px); margin: 6px 0 4px; }
  .tube {
    position: relative; display: grid; place-items: center;
    width: clamp(34px, 7vw, 54px); height: clamp(60px, 12vw, 92px);
    border: 1px solid rgba(221, 213, 233, 0.16); border-radius: 40% 40% 10px 10px / 22% 22% 10px 10px;
    box-shadow: inset 0 0 12px rgba(0, 0, 0, 0.6);
    /* The fine wire mesh in front of the digits. */
    background-image: radial-gradient(ellipse at 50% 30%, rgba(255, 150, 60, 0.08), transparent 70%), repeating-linear-gradient(60deg, rgba(221, 213, 233, 0.05) 0 1px, transparent 1px 6px), repeating-linear-gradient(-60deg, rgba(221, 213, 233, 0.05) 0 1px, transparent 1px 6px);
  }
  .tube.dot { width: clamp(16px, 3vw, 24px); }
  .tube b {
    font-family: var(--display); font-weight: 300; font-size: clamp(34px, 7vw, 58px); line-height: 1;
    color: #ffb36b;
    text-shadow: 0 0 4px #ff8a2a, 0 0 12px rgba(255, 110, 20, 0.85), 0 0 28px rgba(255, 90, 0, 0.5);
  }
  .tube.dot b { font-size: clamp(30px, 6vw, 50px); translate: 0 18%; }
  .tube.flicker b { opacity: 0.75; }
  .worldline { color: #ffb36b; letter-spacing: 0.3em; }
  @media (prefers-reduced-motion: no-preference) {
    .tube b { animation: nixie 4s steps(1) infinite; }
    .tube:nth-child(3n) b { animation-delay: -1.7s; }
    .tube:nth-child(4n + 1) b { animation-delay: -2.9s; }
  }
  /* Now and then a tube dims for an instant, as real ones do. */
  @keyframes nixie { 0%, 100% { opacity: 1; } 47% { opacity: 0.82; } 48% { opacity: 1; } 71% { opacity: 0.9; } 72% { opacity: 1; } }
</style>

<script>
  // The meter wanders through other world lines for a moment, then settles one tube at a time.
  const run = () => {
    const meter = document.querySelector<HTMLElement>('[data-divergence]');
    if (!meter || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const digits = [...meter.querySelectorAll<HTMLElement>('.tube:not(.dot) b')];
    const target = digits.map((d) => d.textContent ?? '');
    const start = performance.now();
    const tick = (now: number) => {
      const t = now - start;
      let busy = false;
      digits.forEach((d, i) => {
        if (t < 900 + i * 180) { d.textContent = String(Math.floor(Math.random() * 10)); busy = true; }
        else d.textContent = target[i];
      });
      if (busy) setTimeout(() => requestAnimationFrame(tick), 55);
    };
    requestAnimationFrame(tick);
  };
  document.addEventListener('astro:page-load', run);
</script>
