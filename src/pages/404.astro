---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
---
<Base lang="es" title={t('es', '404.title')}>
  <main id="main" class="page-head" data-pose="page" style="min-height:100svh;align-content:center;padding-top:0">
    <p class="hud label">404</p>
    <h1 class="display">{t('es', '404.title')} · <span lang="en">{t('en', '404.title')}</span></h1>
    <p class="lead" style="max-width:48ch">{t('es', '404.text')}<br /><span lang="en">{t('en', '404.text')}</span></p>
    <p style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href="/es/">{t('es', '404.home')}</a><a class="btn" href="/en/" lang="en">{t('en', '404.home')}</a></p>
  </main>
</Base>
