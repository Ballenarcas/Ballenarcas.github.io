---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { author, t, type Lang } from '../../../i18n/ui';
import { projectsFor } from '../../../lib';

export async function getStaticPaths() {
  const all = await getCollection('projects', (p) => !(import.meta.env.PROD && p.data.draft));
  return all.map((entry) => {
    const [lang, slug] = entry.id.split('/');
    return { params: { lang, slug }, props: { entry } };
  });
}
const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug;
const d = entry.data;
const { Content } = await render(entry);
const list = await projectsFor(lang);
const next = list[(list.findIndex((p) => p.id === entry.id) + 1) % list.length];
const nextSlug = next.id.split('/')[1];
const portrait = d.videoOrientation === 'portrait';
const poster = d.videoPoster ? await getImage({ src: d.videoPoster, width: portrait ? 720 : 1280, format: 'webp' }) : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  description: d.summary,
  author: { '@type': 'Person', name: author.fullName },
  codeRepository: d.repo,
  inLanguage: lang,
};
---
<Base lang={lang} title={d.title} description={d.summary} themeColor={d.ground} jsonLd={jsonLd}>
  <header class={`phead field ${portrait ? 'portrait' : 'landscape'}`} id="top" style={`--g:${d.ground};--i:${d.ink}`}>
    <Nav lang={lang} />
    <div class="phead-text">
      <h1 class="mon"><span class="mask"><span transition:name={`title-${slug}`}>{d.title}</span></span></h1>
      <p class="statement" data-r style="--d:3">{d.tagline}</p>
      <p data-r style="--d:4;max-width:46ch">{d.summary}</p>
      <dl class="phead-facts" data-r style="--d:5">
        {d.role && <div><dt>{t(lang, 'project.role')}</dt><dd>{d.role}</dd></div>}
        <div><dt>{d.context ? t(lang, 'project.context') : t(lang, 'project.year')}</dt><dd>{[d.context, d.year].filter(Boolean).join(' · ')}</dd></div>
        <div class="wide"><dt>{t(lang, 'project.stack')}</dt><dd>{d.stack.join(', ')}</dd></div>
      </dl>
      <p data-r style="--d:6"><a class="btn" href={d.repo} rel="noopener">{t(lang, 'work.repo')}</a></p>
    </div>
    {d.video && (
      <div class="film-box" data-r style="--d:2">
        <figure class={`film ${portrait ? 'portrait' : 'landscape'}`}>
          <video src={d.video} poster={poster?.src} width={portrait ? 720 : 1280} height={portrait ? 1280 : d.videoPoster ? Math.round((1280 * d.videoPoster.height) / d.videoPoster.width) : 720}
            controls muted playsinline preload="none" aria-label={`${t(lang, 'project.film')}: ${d.title}`} data-autoplay></video>
        </figure>
        {d.videoNote && <p class="film-note soft">{d.videoNote}</p>}
      </div>
    )}
  </header>
  <main id="main">
    <article class="pbody"><Content /></article>
    {d.gallery.length > 0 && (
      <section class={`gallery ${portrait ? 'portrait' : 'landscape'}`}>
        <h2 class="head" data-r>{t(lang, 'project.gallery')}</h2>
        {d.gallery.map((g, i) => (
          <figure data-r style={`--d:${i % 4}`}>
            <Image src={g.src} alt={g.alt} widths={portrait ? [360, 560, 780] : [640, 1024, 1680]}
              sizes={portrait ? '(min-width: 900px) 25vw, 50vw' : '(min-width: 900px) 50vw, 100vw'} loading="lazy" />
          </figure>
        ))}
      </section>
    )}
    <a class="next field" href={`/${lang}/projects/${nextSlug}/`} style={`--g:${next.data.ground};--i:${next.data.ink}`}>
      <span class="head">{t(lang, 'project.next')}</span>
      <span class="mon">{next.data.title}</span>
    </a>
  </main>
  <Footer lang={lang} />
</Base>
