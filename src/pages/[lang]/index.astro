---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Work from '../../components/Work.astro';
import Band from '../../components/Band.astro';
import About from '../../components/About.astro';
import Footer from '../../components/Footer.astro';
import { author, languages, t, type Lang } from '../../i18n/ui';
import { projectsFor } from '../../lib';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const projects = await projectsFor(lang);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.fullName,
  url: Astro.site,
  email: `mailto:${author.email}`,
  jobTitle: lang === 'es' ? 'Estudiante de Ingeniería del Software' : 'Software engineering student',
  sameAs: [author.github, author.linkedin],
};
---
<Base lang={lang} jsonLd={jsonLd} themeColor={projects[0]?.data.ground}>
  <Hero lang={lang} projects={projects} />
  <main id="main">
    <Work lang={lang} projects={projects} />
    <Band />
    <About lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
