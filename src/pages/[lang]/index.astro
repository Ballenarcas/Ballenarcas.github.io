---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Instruments from '../../components/Instruments.astro';
import Hero from '../../components/Hero.astro';
import AboutScene from '../../components/AboutScene.astro';
import SkillsScene from '../../components/SkillsScene.astro';
import Expeditions from '../../components/Expeditions.astro';
import Contact from '../../components/Contact.astro';
import { author, languages, type Lang } from '../../i18n/ui';
import { projectsFor } from '../../lib';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const projects = await projectsFor(lang);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.fullName,
  url: Astro.site,
  email: `mailto:${author.email}`,
  jobTitle: lang === 'es' ? 'Estudiante de Ingeniería del Software' : 'Software engineering student',
  sameAs: [author.github, author.linkedin],
};
---
<Base lang={lang} jsonLd={jsonLd}>
  <Nav lang={lang} home />
  <Instruments lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <AboutScene lang={lang} />
    <SkillsScene lang={lang} />
    <Expeditions lang={lang} projects={projects} />
  </main>
  <Contact lang={lang} n={5} />
</Base>
