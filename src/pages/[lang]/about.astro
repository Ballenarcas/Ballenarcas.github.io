---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Contact from '../../components/Contact.astro';
import { languages, t, type Lang } from '../../i18n/ui';
import { projectsFor, slugOf } from '../../lib';

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const projects = await projectsFor(lang);
const copy = {
  es: {
    title: 'Cómo trabajo',
    lead: 'Soy Ángel, estudiante de Ingeniería del Software. Me gusta construir software que alguien use de verdad.',
    how: 'Mi forma de trabajar',
    paragraphs: [
      'Empiezo por el problema y por la persona que lo tiene. Antes de escribir código quiero poder explicar en una frase qué resuelve la aplicación y para quién.',
      'Separo el código en capas con contratos claros: rutas, lógica de negocio, datos e interfaz. Así cada parte se puede cambiar, probar y entender sin leer las demás.',
      'Uso herramientas de IA para desarrollar más rápido y también dentro de los productos, siempre con límites escritos: reglas que deciden los números, filtros que revisan el texto y una alternativa cuando el proveedor falla.',
    ],
    work: 'Expediciones',
  },
  en: {
    title: 'How I work',
    lead: 'I am Ángel, a software engineering student. I like building software that someone actually uses.',
    how: 'The way I work',
    paragraphs: [
      'I start from the problem and the person who has it. Before writing code I want to be able to say in one sentence what the app solves and for whom.',
      'I split the code into layers with clear contracts: routes, business logic, data and interface. Each part can then be changed, tested and understood without reading the others.',
      'I use AI tools to build faster and inside the products too, always within written limits: rules that decide the numbers, filters that check the text, and a fallback when the provider fails.',
    ],
    work: 'Expeditions',
  },
}[lang];
---
<Base lang={lang} title={copy.title} description={copy.lead}>
  <Nav lang={lang} />
  <header class="page-head" id="top" data-pose="page">
    <p class="hud label" data-r>{t(lang, 'nav.about')}</p>
    <h1 class="display" data-r style="--d:1">{copy.title}</h1>
    <p class="lead" data-r style="--d:2">{copy.lead}</p>
  </header>
  <main id="main">
    <section class="pbody">
      <h2 data-r>{copy.how}</h2>
      {copy.paragraphs.map((p, i) => <p data-r style={`--d:${i + 1}`}>{p}</p>)}
      <h2 data-r>{copy.work}</h2>
      <ul class="prose" data-r style="--d:1">
        {projects.map((p) => (
          <li><a href={`/${lang}/projects/${slugOf(p)}/`}>{p.data.title}</a>: {p.data.summary}</li>
        ))}
      </ul>
    </section>
    <div style="height: var(--gap)"></div>
  </main>
  <Contact lang={lang} pose="detail-end" />
</Base>
