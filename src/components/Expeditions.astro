---
// The list of projects. It is built from the data files: featured projects become full expeditions,
// the rest a compact list, and the filter shows whatever categories the projects declare.
import { t, type Lang } from '../i18n/ui';
import { categoriesOf, type Project } from '../lib';
import Expedition from './Expedition.astro';
import SceneLabel from './SceneLabel.astro';
interface Props { lang: Lang; projects: Project[] }
const { lang, projects } = Astro.props;
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
const categories = categoriesOf(projects);
---
<section class="scene expeditions" id="expeditions" data-pose="projects">
  <div class="scene-head">
    <SceneLabel n={4} text={t(lang, 'nav.work')} />
    <h2 class="display" data-r style="--d:1">{t(lang, 'work.title')}</h2>
    <p class="lead" data-r style="--d:2">{t(lang, 'work.statement')}</p>
  </div>
  {categories.length > 1 && (
    <div class="filter" data-filter role="group" aria-label={t(lang, 'work.filter')} data-r style="--d:3">
      <button type="button" data-cat="*" aria-pressed="true">{t(lang, 'work.all')}</button>
      {categories.map((c) => <button type="button" data-cat={c} aria-pressed="false">{c}</button>)}
      <span class="hud filter-count" aria-live="polite"><span data-filter-count>{projects.length}</span> {t(lang, 'work.count')}</span>
    </div>
  )}
  {featured.map((p, i) => <Expedition lang={lang} project={p} index={i} />)}
  {rest.length > 0 && (
    <div class="more">
      <h3 class="hud">{t(lang, 'work.more')}</h3>
      {rest.map((p, i) => <Expedition lang={lang} project={p} index={featured.length + i} compact />)}
    </div>
  )}
</section>
