---
import { skills, t, type Lang, type UiKey } from '../i18n/ui';
interface Props { lang: Lang; link?: boolean }
const { lang, link = true } = Astro.props;
---
<section class="about" id="about">
  <div class="about-lead">
    <h2 class="head" data-r>{t(lang, 'about.title')}</h2>
    <p class="statement" data-r style="--d:1">{t(lang, 'about.statement')}</p>
    {link && <p data-r style="--d:2"><a class="btn" href={`/${lang}/about/`}>{t(lang, 'about.more')}</a></p>}
  </div>
  <dl class="facts" data-r style="--d:2">
    {Object.entries(skills).map(([k, v]) => (
      <div><dt>{t(lang, k as UiKey)}</dt><dd>{v}</dd></div>
    ))}
  </dl>
</section>
