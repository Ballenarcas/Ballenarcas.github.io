---
import { author, t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<footer class="contact" id="contact">
  <div data-r>
    <h2 class="head">{t(lang, 'contact.title')}</h2>
    <p class="statement" style="margin-top:14px">{t(lang, 'contact.sentence')}</p>
  </div>
  <a class="mail" href={`mailto:${author.email}`} data-r>{author.email}</a>
  <div class="contact-row" data-r>
    <ul>
      <li><a href={author.github} rel="me noopener">GitHub</a></li>
      <li><a href={author.linkedin} rel="me noopener">LinkedIn</a></li>
    </ul>
    <ul>
      <li><a href="#top">{t(lang, 'footer.top')}</a></li>
    </ul>
  </div>
  <p class="foot-name" aria-hidden="true">{author.name}</p>
</footer>
